{
  "version": 1,
  "note": "Synthetic multimodal pseudo-causal corpus (MM3). Every original is a few generated bytes, not a real screenshot, recording or report. Each case writes one claim through Repository.add after registering the originals as attachments. Placeholders in evidence: {att:K} att:<id>, {id:K} the id, {ID:K} it uppercased, {sha:K} the sha256 hex, {SHA:K} it uppercased, {sha16:K} its first 16 hex, {sha_zw:K} the hex with U+200B inside, {file:K} a copy of the original outside the vault, {file_pct:K} that path percent-encoded, {blob:K} the blob path.",
  "attachments": {
    "deploy_screenshot": {
      "name": "deploy-latency.png",
      "media_type": "image/png",
      "text": "synthetic screenshot: dashboard p99 latency 120 ms before deploy 4812, 80 ms after"
    },
    "incident_call": {
      "name": "incident-call.m4a",
      "media_type": "audio/mp4",
      "text": "synthetic recording: 'latency dropped because we warmed the cache'"
    },
    "latency_report": {
      "name": "latency-report.pdf",
      "media_type": "application/pdf",
      "text": "%PDF-1.4 synthetic report: page 2 chart, error rate fell after the config change"
    },
    "dashboard_video": {
      "name": "dashboard.mp4",
      "media_type": "video/mp4",
      "text": "synthetic screen recording: queue depth falls a minute after the rollout"
    }
  },
  "claim": {
    "title": "The deploy caused the latency drop",
    "body": "Synthetic claim: after deploy 4812 the p99 latency dropped, so the deploy caused it.",
    "epistemic": "inference",
    "causal": "verified",
    "causal_record": {
      "treatment": "deploy 4812",
      "outcome": "p99 latency",
      "estimand": "effect of deploy 4812 on p99 latency",
      "temporal_order": "deploy before the drop",
      "identification": {
        "assumptions": ["no other change in the window"],
        "untested": []
      },
      "robustness": [
        {"check": "compared the week before", "result": "same drop", "failed": false}
      ],
      "proposed_by": "synthetic fixture"
    },
    "source": "synthetic",
    "provenance": "human-authored"
  },
  "cases": [
    {
      "name": "screenshot_after_deploy",
      "group": "spurious",
      "expect": "reject",
      "note": "A screenshot showing latency fell after a deploy offered as causal evidence.",
      "evidence": ["{att:deploy_screenshot}#bbox=10,20,300,180"]
    },
    {
      "name": "screenshot_as_fact",
      "group": "spurious",
      "expect": "reject",
      "note": "The same screenshot recorded as a fact with no causal claim (cap before the early return).",
      "set": {"epistemic": "fact", "causal": "none", "causal_record": null},
      "evidence": ["{att:deploy_screenshot}"]
    },
    {
      "name": "transcript_because",
      "group": "spurious",
      "expect": "reject",
      "note": "A recording in which someone says 'because we warmed the cache': speech, not identification.",
      "set": {"source": "transcript"},
      "evidence": ["{att:incident_call}#t=12.5,20.0"]
    },
    {
      "name": "transcript_because_fact",
      "group": "spurious",
      "expect": "reject",
      "set": {"epistemic": "fact", "causal": "none", "causal_record": null},
      "evidence": ["{att:incident_call}#t=12.5,20.0", "transcript:synthetic-call-7"]
    },
    {
      "name": "pdf_chart_page",
      "group": "spurious",
      "expect": "reject",
      "note": "A chart on page 2 of a report showing the error rate fell after a change.",
      "evidence": ["{att:latency_report}#page=2&bbox=72,100,540,400"]
    },
    {
      "name": "video_keyframe",
      "group": "spurious",
      "expect": "reject",
      "evidence": ["{att:dashboard_video}#frame=t:65.0"]
    },
    {
      "name": "several_observations",
      "group": "spurious",
      "expect": "reject",
      "note": "Many observations of the same co-occurrence are still observations.",
      "evidence": [
        "{att:deploy_screenshot}",
        "{att:dashboard_video}#t=60,70",
        "{att:latency_report}#page=2",
        "chat:synthetic-thread-3"
      ]
    },
    {
      "name": "observation_and_chat_link",
      "group": "spurious",
      "expect": "reject",
      "note": "A screenshot plus a pasted link in a chat-sourced memory.",
      "set": {"source": "chat"},
      "evidence": ["{att:deploy_screenshot}", "https://example.invalid/dashboards/latency"]
    },
    {
      "name": "bypass_sha256",
      "group": "bypass",
      "expect": "reject",
      "evidence": ["sha256:{sha:deploy_screenshot}"]
    },
    {
      "name": "bypass_sha256_uppercase",
      "group": "bypass",
      "expect": "reject",
      "evidence": ["SHA256:{SHA:deploy_screenshot}"]
    },
    {
      "name": "bypass_sha256_prefix",
      "group": "bypass",
      "expect": "reject",
      "evidence": ["sha256:{sha16:deploy_screenshot}"]
    },
    {
      "name": "bypass_sha256_zero_width",
      "group": "bypass",
      "expect": "reject",
      "evidence": ["sha256:{sha_zw:deploy_screenshot}"]
    },
    {
      "name": "bypass_sha256_fact",
      "group": "bypass",
      "expect": "reject",
      "set": {"epistemic": "fact", "causal": "none", "causal_record": null},
      "evidence": ["sha256:{sha:latency_report}"]
    },
    {
      "name": "bypass_file_copy",
      "group": "bypass",
      "expect": "reject",
      "note": "file: pointing at a copy of the registered original.",
      "evidence": ["file:{file:deploy_screenshot}"]
    },
    {
      "name": "bypass_file_blob",
      "group": "bypass",
      "expect": "reject",
      "evidence": ["file:{blob:deploy_screenshot}"]
    },
    {
      "name": "bypass_file_url_mixed_case",
      "group": "bypass",
      "expect": "reject",
      "evidence": ["FILE://localhost{file:incident_call}"]
    },
    {
      "name": "bypass_file_percent_encoded",
      "group": "bypass",
      "expect": "reject",
      "evidence": ["file:{file_pct:latency_report}"]
    },
    {
      "name": "bypass_att_mixed_case",
      "group": "bypass",
      "expect": "reject",
      "set": {"epistemic": "fact", "causal": "none", "causal_record": null},
      "evidence": ["ATT:{ID:deploy_screenshot}"]
    },
    {
      "name": "bypass_att_percent_encoded",
      "group": "bypass",
      "expect": "reject",
      "set": {"epistemic": "fact", "causal": "none", "causal_record": null},
      "evidence": ["%61tt:{id:deploy_screenshot}"]
    },
    {
      "name": "bypass_id_inside_result",
      "group": "bypass",
      "expect": "reject",
      "evidence": ["result:{id:dashboard_video}"]
    },
    {
      "name": "bypass_hash_inside_experiment",
      "group": "bypass",
      "expect": "reject",
      "evidence": ["experiment:frame-of-{sha:dashboard_video}"]
    },
    {
      "name": "bypass_kh_pdf",
      "group": "bypass",
      "expect": "reject",
      "note": "kh: to a PDF is not outside-vault evidence; it cannot carry verified.",
      "evidence": ["kh:Reports/latency-report.pdf"]
    },
    {
      "name": "bypass_kh_pdf_with_observation",
      "group": "bypass",
      "expect": "reject",
      "set": {"epistemic": "fact", "causal": "none", "causal_record": null},
      "evidence": ["kh:Reports/latency-report.pdf", "{att:latency_report}#page=2"]
    },
    {
      "name": "hygiene_missing_attachment",
      "group": "hygiene",
      "expect": "reject",
      "set": {"epistemic": "experience", "causal": "none", "causal_record": null},
      "evidence": ["att:att-0190a000-0000-7000-8000-000000000000"]
    },
    {
      "name": "hygiene_locator_wrong_media",
      "group": "hygiene",
      "expect": "reject",
      "set": {"epistemic": "experience", "causal": "none", "causal_record": null},
      "evidence": ["{att:deploy_screenshot}#page=3"]
    },
    {
      "name": "hygiene_inverted_time",
      "group": "hygiene",
      "expect": "reject",
      "set": {"epistemic": "experience", "causal": "none", "causal_record": null},
      "evidence": ["{att:incident_call}#t=20,12"]
    },
    {
      "name": "control_observation_experience",
      "group": "control",
      "expect": "accept",
      "note": "What was seen, recorded as an experience: allowed.",
      "set": {"epistemic": "experience", "causal": "none", "causal_record": null},
      "evidence": ["{att:deploy_screenshot}#bbox=10,20,300,180"]
    },
    {
      "name": "control_observation_hypothesis",
      "group": "control",
      "expect": "accept",
      "note": "From an observation to a causal hypothesis: allowed, labelled as such.",
      "set": {"causal": "hypothesis"},
      "evidence": ["{att:deploy_screenshot}", "{att:incident_call}#t=12.5,20.0"]
    },
    {
      "name": "control_observation_hypothesis_by_agent",
      "group": "control",
      "expect": "accept",
      "set": {"causal": "hypothesis", "actor": "mechanism", "provenance": "llm"},
      "evidence": ["{att:latency_report}#page=2"]
    },
    {
      "name": "control_observation_plus_experiment",
      "group": "control",
      "expect": "accept",
      "note": "An identified analysis with replayable data still passes when it also cites the screenshot.",
      "evidence": ["{att:deploy_screenshot}", "experiment:synthetic-ab-4812", "dataset:synthetic-latency-ab"]
    },
    {
      "name": "control_unregistered_file",
      "group": "control",
      "expect": "accept",
      "note": "A file: pointer that names no registered attachment keeps its raw class (default unchanged).",
      "evidence": ["file:/srv/synthetic/latency-ab-results.csv"]
    }
  ]
}
