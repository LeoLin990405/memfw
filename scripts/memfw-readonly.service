[Unit]
Description=MemFW read-only memory service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/home/leo/memfw-remote/memfw-readonly.env
ExecStart=/usr/bin/python3 /home/leo/memfw-remote/memfw_readonly_service.py --root /vol1/fleet-memory/memfw-vault --host 0.0.0.0 --port 18080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
